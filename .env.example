# 工作台始终建议只绑定回环地址。
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=4174

# 新手保护额度，可按需要降低。单位：人民币元。
MAX_ORDER_VALUE=1000
MAX_DAILY_VALUE=3000

# tencent 为公开参考行情；设为 demo 时，实盘预览不会把演示价格当成核价依据。
MARKET_DATA_PROVIDER=tencent

# 默认必须保持 false。只有账户获批官方 API 且桥接服务就绪后才可改为 true。
LIVE_TRADING_ENABLED=false

# 可选：使用环境变量时，工作台不会写入本地 DPAPI 密钥文件。
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# 仅用于获批后的国泰海通官方桥接，不支持君弘普通账户登录信息。
# GTJA_API_BRIDGE_URL=http://127.0.0.1:9001
# GTJA_API_BRIDGE_TOKEN=
# GTJA_CLIENT_PATH=C:\\Path\\To\\OfficialClient.exe

# 仅用于已购买并获批的同花顺 SuperMind 实盘桥接。
# SUPERMIND_BRIDGE_URL=http://127.0.0.1:9002
# SUPERMIND_BRIDGE_TOKEN=
